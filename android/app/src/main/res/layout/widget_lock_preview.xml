<?xml version="1.0" encoding="utf-8"?>
<!-- 照着真卡（2×2）画：右上角一颗锁状态徽标、中间车图、底部一行状态。
     预览里没有真车图，用剪影顶上——用户没登录时看到的也是这一张。
     留白和字号跟着 `LockWidget` 走，两边改一处就得改另一处。

     **只能用 RemoteViews 白名单里的 View 类型**：`<View>` 和 `<Space>` 都不在白名单里，
     写了就整张预览变成「无法加载微件」，Launcher 还会连 targetCellWidth 一起忽略。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_unlock_label" android:textColor="#FFF2F5FA"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="6dp"
            android:src="@drawable/ic_widget_lock_open"
            android:background="@drawable/widget_preview_badge"
            android:contentDescription="@null"
            android:tint="#FF08150D" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="4dp"
        android:src="@drawable/ic_widget_car"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:tint="#47F2F5FA" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_status"
        android:textColor="#FFF2F5FA"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_native_card_bg"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_medium_vehicle_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_native_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_medium_soc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_native_primary"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/widget_medium_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/widget_native_secondary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_medium_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_native_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_medium_energy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:indeterminate="false"
                android:max="100"
                android:progressBackgroundTint="@color/widget_native_track"
                android:progressTint="@color/widget_native_energy" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_medium_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_native_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="146dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_medium_action_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_action_tile_bg"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_medium_action_icon_0" android:layout_width="17dp" android:layout_height="17dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_medium_action_title_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <ImageView android:layout_width="7dp" android:layout_height="match_parent" android:contentDescription="@null" />
            <LinearLayout
                android:id="@+id/widget_medium_action_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_action_tile_bg"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_medium_action_icon_1" android:layout_width="17dp" android:layout_height="17dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_medium_action_title_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView android:layout_width="match_parent" android:layout_height="7dp" android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_medium_action_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_action_tile_bg"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_medium_action_icon_2" android:layout_width="17dp" android:layout_height="17dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_medium_action_title_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <ImageView android:layout_width="7dp" android:layout_height="match_parent" android:contentDescription="@null" />
            <LinearLayout
                android:id="@+id/widget_medium_action_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_action_tile_bg"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/widget_medium_action_icon_3" android:layout_width="17dp" android:layout_height="17dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_medium_action_title_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

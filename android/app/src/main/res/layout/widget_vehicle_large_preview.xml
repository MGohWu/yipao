<?xml version="1.0" encoding="utf-8"?>
<!-- 车况大卡（4×4）在选择器里的静态预览。数字是示意值，不是真车况——用户添加之后
     Glance 立刻会用真实快照重画。

     照着 `LargeLayout` 真实的样子画：车名+状态+刷新 / 车模主视觉 / 车下面那块读数 /
     四颗横排按钮。读数在车**下面**，不在上面。预览和真卡长得不一样的话，用户是照着
     预览决定要不要添加的，添完发现是另一张卡。

     **只能用 RemoteViews 白名单里的 View 类型**：这张布局是被当作 RemoteViews
     inflate 的，`<View>` 和 `<Space>` 都不在白名单里，写了就整张预览变成
     「无法加载微件」——而且 Launcher 拿不到 previewLayout 时会连 targetCellWidth
     一起忽略，退回按 minWidth 算格数，落地尺寸也跟着不对。
     纯占位和纯色块一律用 ImageView 顶。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_vehicle"
            android:textColor="#FFF2F5FA"
            android:maxLines="1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="@string/widget_preview_status"
            android:textColor="#99F2F5FA"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 车图最宽只占内容宽的七成（iOS `carWidthRatio`），左右各让出 15%。
         RemoteViews 里取不到「按比例的宽度」，用两条 weight 占位撑出这个比例。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="15"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="70"
            android:src="@drawable/ic_widget_car"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:tint="#66F2F5FA" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="15"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 车图下面那块读数：图标 + 大数字 + 「%」 + 续航，底下压一条进度条。
         预览画纯电车（一段铺满整行），增程车才切成左右两段。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/ic_widget_bolt"
            android:contentDescription="@null"
            android:tint="#99F2F5FA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="@string/widget_preview_soc"
            android:textColor="#FFF2F5FA"
            android:maxLines="1"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/widget_preview_percent"
            android:textColor="#99F2F5FA"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:text="@string/widget_preview_range"
            android:textColor="#99F2F5FA"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:background="@drawable/widget_preview_bar_track">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="76"
            android:contentDescription="@null"
            android:background="@drawable/widget_preview_bar_fill" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="24"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_tile_accent">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_widget_lock"
                android:contentDescription="@null"
                android:tint="#FF4DC47D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_preview_lock"
                android:textColor="#FF4DC47D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_tile_cool">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_widget_climate"
                android:contentDescription="@null"
                android:tint="#99F2F5FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_preview_climate"
                android:textColor="#99F2F5FA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_tile_cool">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_widget_trunk"
                android:contentDescription="@null"
                android:tint="#99F2F5FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_preview_trunk"
                android:textColor="#99F2F5FA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_preview_tile_cool">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_widget_horn"
                android:contentDescription="@null"
                android:tint="#99F2F5FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_preview_horn"
                android:textColor="#99F2F5FA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
